DATABASE_URL=postgresql://snl:local-development-only@localhost:5432/snl
# For Supabase, paste the Session pooler URI from the project's Connect dialog.
# Replace its password placeholder with the percent-encoded database password.
# Never put real credentials in this example file.
DATABASE_POOL_MAX=5
# Supabase's public CA is bundled. Optional override for a different CA:
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
ADMIN_PASSWORD=
PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
TRUST_PROXY=0
